{
    "development": {
      "use_env_variable": "DATABASE_URL_DEV",
      "dialect": "postgres"
    },
    "production": {
      "use_env_variable": "DATABASE_URL",
      "dialect": "postgres",
      "protocol": "postgres",
      "dialectOptions": {
        "ssl": {
          "require": true,
          "rejectUnauthorized": false
        }
      }
    }
  }
  